# Production Environment Variables for PhoenixAI Studio
# Copy this file to .env.production and fill in actual values before deployment

# ============================================
# DATABASE (REQUIRED)
# ============================================
# IMPORTANT: SQLite is NOT production-safe for Netlify serverless deployment
# Use MySQL (PlanetScale, AWS RDS, or managed MySQL service)
# Example: mysql://user:password@host:3306/phoenixai_studio
DATABASE_URL="mysql://user:password@host:3306/phoenixai_studio"

# ============================================
# AUTHENTICATION (REQUIRED)
# ============================================
# JWT secret for token generation (use a strong random string)
JWT_SECRET="your-strong-jwt-secret-here"

# NextAuth secret (if using NextAuth instead of custom JWT)
NEXTAUTH_SECRET="your-strong-nextauth-secret-here"

# Production site URL (MUST be actual production URL, NOT localhost)
NEXTAUTH_URL="https://phoenixai.studio"

# Admin password for initial admin account (STRONG password required)
# DO NOT use default 'admin123' in production
ADMIN_PASSWORD="your-strong-admin-password-here"

# ============================================
# PUBLIC VARIABLES (REQUIRED)
# ============================================
# Public site URL (for secure cookie detection and metadata)
NEXT_PUBLIC_SITE_URL="https://phoenixai.studio"

# ============================================
# OPTIONAL AI PROVIDERS
# ============================================
# OpenAI API key (for OpenAI integration)
OPENAI_API_KEY="sk-your-openai-key-here"

# Gemini API key (for Salon Chat AI feature)
GEMINI_API_KEY="your-gemini-api-key-here"

# ============================================
# OPTIONAL EMAIL CONFIGURATION
# ============================================
# SMTP configuration for password reset emails
EMAIL_USER="your-email@example.com"
EMAIL_PASS="your-email-password"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"

# ============================================
# DEPLOYMENT NOTES
# ============================================
# 1. After changing DATABASE_URL to MySQL:
#    - Update prisma/schema.prisma datasource provider to "mysql"
#    - Run: npx prisma generate
#    - Run: npx prisma migrate deploy (or create initial migration)
#    - Seed production database if needed

# 2. For Netlify deployment:
#    - Add all above variables to Netlify environment variables
#    - Ensure DATABASE_URL points to MySQL, not SQLite
#    - Do NOT use file:./dev.db in production

# 3. For Vercel deployment:
#    - Add all above variables to Vercel environment variables
#    - Configure MySQL database (PlanetScale recommended)
#    - Ensure DATABASE_URL is MySQL connection string
